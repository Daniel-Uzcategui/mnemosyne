{
  "server": {
    "port": 8080,
    "host": "0.0.0.0"
  },
  "storage": {
    "modelsDir": "$HOME/Models",
    "l1Dir": "$HOME/Models/ramdisk_cache",
    "l2Dir": "$HOME/Models/slot_cache",
    "backendLogDir": "$HOME/qwencode/runtime-logs"
  },
  "backends": [
    {
      "id": "llama-a",
      "host": "127.0.0.1",
      "port": 11434,
      "gpuGroup": "2,3",
      "maxSlots": 1,
      "scriptPath": "$HOME/qwencode/config/start_server.example.sh",
      "modelName": "qwen"
    },
    {
      "id": "llama-b",
      "host": "127.0.0.1",
      "port": 11435,
      "gpuGroup": "0,1",
      "maxSlots": 1,
      "scriptPath": "$HOME/qwencode/config/start_server2.example.sh",
      "modelName": "qwen"
    }
  ],
  "cache": {
    "l1EvictThresholdBytes": 2684354560,
    "l1EvictTargetBytes": 2147483648,
    "partialCacheMinScore": 0.3,
    "partialCacheSystemBonus": 0.12,
    "partialCacheSuccessBonus": 0.08,
    "partialCacheFailurePenalty": 0.18
  },
  "health": {
    "backendHealthcheckIntervalMs": 5000,
    "backendHealthcheckTimeoutMs": 1500,
    "dedupWaitTimeoutMs": 15000,
    "backendStartupGraceMs": 12000,
    "backendAutoStart": true
  },
  "gc": {
    "gcIntervalMs": 300000,
    "maxFileAgeMs": 43200000
  },
  "misc": {
    "warmupTopN": 15,
    "ragContentLengthThreshold": 1000,
    "hashChunkSize": 65536,
    "hashYieldInterval": 8,
    "largeInputCooperativeThreshold": 262144,
    "subagentModel": "fast",
    "subagentPromptPatterns": [
      "managed memory extraction subagent",
      "you are now acting as",
      "specialist agent",
      "read-only exploration task"
    ]
  }
}